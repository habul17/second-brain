# Copy to .env.local for local development.

# Postgres. Local: `pnpm dev:db` serves PGlite on port 5433. Production: Neon.
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/postgres

# Auth. Make a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google and GitHub login (buttons appear when set)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: email for password reset (without it, "Forgot password?" is hidden)
# RESEND_API_KEY=
# EMAIL_FROM="Second Brain <brain@yourdomain.com>"

# Reminders: the scheduler sends this as a Bearer token. openssl rand -hex 24
CRON_SECRET=

# Web Push keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
